---
export interface Item {
  src: string;
  alt: string;
  caption?: string;
}

export interface Props {
  items: Item[];
}

const { items } = Astro.props;
---

<div class="figure-grid">
  {
    items.map((item) => (
      <figure class="figure">
        <img src={item.src} alt={item.alt} loading="lazy" />
        {item.caption && <figcaption>{item.caption}</figcaption>}
      </figure>
    ))
  }
</div>
