---
import { site } from "../data/site";

const { currentPath = "/" } = Astro.props;

const links = [
  { href: "/", label: "Home", icon: "home" },
  { href: "/blog", label: "Blog", icon: "blog" },
  { href: "/publications", label: "Publications", icon: "publications" },
  { href: "/Nikhil_Paleti_Resume.pdf", label: "Resume", icon: "resume", external: true }
];

const socials = [
  { label: "GitHub", href: site.social.github, icon: "github" },
  { label: "LinkedIn", href: site.social.linkedin, icon: "linkedin" },
  { label: "Scholar", href: site.social.scholar, icon: "scholar" },
  { label: "X", href: site.social.x, icon: "x" }
];
---

<aside class="sidebar" data-sidebar>
  <div class="sidebar-inner">
    <div class="sidebar-main">
      <div class="sidebar-profile">
        <a class="sidebar-name" href="/">{site.author}</a>
        <p class="sidebar-role">{site.role}</p>
      </div>

      <nav class="sidebar-nav" aria-label="Primary">
        <ul class="sidebar-nav-list">
          {
            links.map((link) => (
              <li>
                <a
                  href={link.href}
                class:list={[
                  "sidebar-link",
                  currentPath === link.href ||
                  (link.href !== "/" && currentPath.startsWith(link.href))
                    ? "is-active"
                    : undefined
                ]}
                target={link.external ? "_blank" : undefined}
                rel={link.external ? "noopener noreferrer" : undefined}
              >
                <span class="sidebar-link-mark" aria-hidden="true">
                  {link.icon === "home" && (
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                      <path
                        fill="currentColor"
                        d="M12 3.8 4 10.2v9h5.3v-5.1h5.4v5.1H20v-9l-8-6.4Zm0-1.9 9.5 7.6v11.2h-8.3v-5.1h-2.4v5.1H2.5V9.5L12 1.9Z"
                      />
                    </svg>
                  )}
                  {link.icon === "blog" && (
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                      <path
                        fill="currentColor"
                        d="M5 4.5h14a1.5 1.5 0 0 1 1.5 1.5v12A1.5 1.5 0 0 1 19 19.5H5A1.5 1.5 0 0 1 3.5 18V6A1.5 1.5 0 0 1 5 4.5Zm0 1.5v12h14V6H5Zm2.2 2.2h9.6v1.5H7.2V8.2Zm0 3.5h9.6v1.5H7.2v-1.5Zm0 3.5h6.1v1.5H7.2v-1.5Z"
                      />
                    </svg>
                  )}
                  {link.icon === "publications" && (
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                      <path
                        fill="currentColor"
                        d="M6 3.5h9.8L20.5 8v12a.5.5 0 0 1-.5.5H6A2.5 2.5 0 0 1 3.5 18V6A2.5 2.5 0 0 1 6 3.5Zm0 1.5A1 1 0 0 0 5 6v12a1 1 0 0 0 1 1h13V8.8L15.2 5H6Zm2 4h8v1.5H8V9Zm0 3.5h8v1.5H8v-1.5Zm0 3.5h5v1.5H8V16Z"
                      />
                    </svg>
                  )}
                  {link.icon === "about" && (
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                      <path
                        fill="currentColor"
                        d="M12 3.5a8.5 8.5 0 1 1 0 17 8.5 8.5 0 0 1 0-17Zm0 1.5a7 7 0 1 0 0 14 7 7 0 0 0 0-14Zm-.75 4h1.5v1.5h-1.5V9Zm0 3h1.5v6h-1.5v-6Z"
                      />
                    </svg>
                  )}
                  {link.icon === "resume" && (
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                      <path
                        fill="currentColor"
                        d="M6 3.5h9.5l4 4V20a.5.5 0 0 1-.5.5H6A1.5 1.5 0 0 1 4.5 19V5A1.5 1.5 0 0 1 6 3.5Zm0 1.5v14h12V8.2L14.8 5H6Zm2 3h5v1.5H8V8Zm0 3h8v1.5H8v-1.5Zm0 3h8V15H8v-1.5Z"
                      />
                    </svg>
                  )}
                </span>
                <span>{link.label}</span>
              </a>
            </li>
            ))
          }
        </ul>
      </nav>
    </div>

    <div class="sidebar-footer">
      <div class="sidebar-socials">
        <button
          type="button"
          class="sidebar-social sidebar-theme-toggle"
          data-theme-toggle
          aria-label="Toggle theme"
        >
          <svg viewBox="0 0 24 24" aria-hidden="true" data-theme-icon="sun">
            <path
              fill="currentColor"
              d="M12 17.25A5.25 5.25 0 1 0 12 6.75a5.25 5.25 0 0 0 0 10.5ZM12 1.5a.75.75 0 0 1 .75.75v2.1a.75.75 0 0 1-1.5 0v-2.1A.75.75 0 0 1 12 1.5Zm0 17.55a.75.75 0 0 1 .75.75v2.1a.75.75 0 0 1-1.5 0v-2.1a.75.75 0 0 1 .75-.75ZM4.35 11.25a.75.75 0 0 1 0 1.5h-2.1a.75.75 0 0 1 0-1.5h2.1Zm17.4 0a.75.75 0 0 1 0 1.5h-2.1a.75.75 0 0 1 0-1.5h2.1ZM6.36 5.3a.75.75 0 0 1 1.06 0l1.48 1.48a.75.75 0 1 1-1.06 1.06L6.36 6.36a.75.75 0 0 1 0-1.06Zm9.74 9.74a.75.75 0 0 1 1.06 0l1.48 1.48a.75.75 0 0 1-1.06 1.06l-1.48-1.48a.75.75 0 0 1 0-1.06ZM18.7 5.3a.75.75 0 0 1 0 1.06l-1.48 1.48a.75.75 0 1 1-1.06-1.06l1.48-1.48a.75.75 0 0 1 1.06 0ZM8.9 15.04a.75.75 0 0 1 0 1.06l-1.48 1.48a.75.75 0 0 1-1.06-1.06l1.48-1.48a.75.75 0 0 1 1.06 0Z"
            />
          </svg>
        </button>

        <span class="sidebar-footer-dot" aria-hidden="true"></span>

        {
          socials.map((item) => (
            <a
              href={item.href}
              class="sidebar-social"
              aria-label={item.label}
              target="_blank"
              rel="noopener noreferrer"
            >
              {item.icon === "github" && (
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <path
                    fill="currentColor"
                    d="M12 2C6.48 2 2 6.58 2 12.23c0 4.51 2.87 8.34 6.84 9.69.5.1.68-.22.68-.49 0-.24-.01-1.04-.01-1.89-2.78.62-3.37-1.21-3.37-1.21-.45-1.18-1.11-1.49-1.11-1.49-.91-.64.07-.63.07-.63 1 .07 1.53 1.06 1.53 1.06.9 1.58 2.35 1.12 2.92.86.09-.67.35-1.12.63-1.38-2.22-.26-4.56-1.15-4.56-5.14 0-1.14.39-2.07 1.03-2.8-.1-.26-.45-1.32.1-2.75 0 0 .84-.28 2.75 1.07A9.3 9.3 0 0 1 12 6.84c.85 0 1.7.12 2.5.36 1.9-1.35 2.74-1.07 2.74-1.07.56 1.43.21 2.49.11 2.75.64.73 1.03 1.66 1.03 2.8 0 4-2.34 4.88-4.57 5.13.36.32.68.94.68 1.9 0 1.37-.01 2.47-.01 2.81 0 .27.18.59.69.49A10.03 10.03 0 0 0 22 12.23C22 6.58 17.52 2 12 2Z"
                  />
                </svg>
              )}
              {item.icon === "linkedin" && (
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <path
                    fill="currentColor"
                    d="M6.94 8.5a1.56 1.56 0 1 1 0-3.12 1.56 1.56 0 0 1 0 3.12ZM8.5 10H5.38v8.62H8.5V10Zm4.97 0H10.4v8.62h3.07v-4.53c0-2.52 3.26-2.75 3.26 0v4.53h3.08v-5.6c0-4.35-4.78-4.19-6.34-2.05V10Z"
                  />
                </svg>
              )}
              {item.icon === "scholar" && (
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <path
                    fill="currentColor"
                    d="m12 3 9 5-9 5-9-5 9-5Zm-6.93 8.54L12 15.42l6.93-3.88A8.53 8.53 0 0 1 12 21a8.53 8.53 0 0 1-6.93-9.46ZM12 7.2a1.8 1.8 0 1 0 0 3.6 1.8 1.8 0 0 0 0-3.6Z"
                  />
                </svg>
              )}
              {item.icon === "x" && (
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <path
                    fill="currentColor"
                    d="M18.9 3H21l-6.55 7.5L22 21h-5.92l-4.63-6.06L6.2 21H4.1l7-8.01L2 3h6.07l4.18 5.52L18.9 3Zm-1.03 16.2h1.64L7.2 4.72H5.43L17.87 19.2Z"
                  />
                </svg>
              )}
            </a>
          ))
        }
      </div>
    </div>
  </div>
</aside>
