---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";

const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

const blogJsonLd = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: "Blog",
  url: `${Astro.site ?? "https://nikhil-paleti.github.io"}/blog/`,
  description:
    "Long-form writing about machine learning systems, optimization, and implementation details.",
  mainEntity: {
    "@type": "ItemList",
    itemListElement: posts.map((post, index) => ({
      "@type": "ListItem",
      position: index + 1,
      url: `${Astro.site ?? "https://nikhil-paleti.github.io"}/blog/${post.slug}/`,
      name: post.data.title
    }))
  }
};
---

<BaseLayout
  title="Blog"
  description="Long-form writing about machine learning systems, optimization, and implementation details."
  jsonLd={blogJsonLd}
>
  <section class="shell page-shell">
    <h1>Blog</h1>
    <p class="lede compact-width">
      Notes on machine learning systems, GPU performance, and things I had to learn
      the hard way.
    </p>

    <div class="stack-list">
      {posts.map((post) => (
        <article class="list-entry">
          <p class="entry-date">
            {post.data.date.toLocaleDateString("en-US", {
              year: "numeric",
              month: "short",
              day: "numeric"
            })}
          </p>
          <div>
            <h2>
              <a href={`/blog/${post.slug}/`}>{post.data.title}</a>
            </h2>
            <p>{post.data.description}</p>
          </div>
        </article>
      ))}
    </div>
  </section>
</BaseLayout>
