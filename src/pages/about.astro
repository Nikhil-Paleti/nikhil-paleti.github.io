---
import BaseLayout from "../layouts/BaseLayout.astro";
import { home, person } from "../data/site";
---
<BaseLayout title="About" description={home.intro} jsonLd={{ "@context": "https://schema.org", ...person }}>
  <section class="shell page-shell about-shell">
    <h1>About my work</h1>
    <p class="lede">{home.intro}</p>
    <div class="about-stack">
      {home.details.map((item) => <section class="about-card"><h2>{item.label}</h2><p>{item.body}</p></section>)}
    </div>
    <p><a href="/publications/">Research publications</a> · <a href="/Nikhil_Paleti_Resume.pdf">Résumé</a></p>
  </section>
</BaseLayout>
