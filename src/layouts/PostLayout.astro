---
import BaseLayout from "./BaseLayout.astro";
import { site } from "../data/site";

interface Props {
  title: string;
  description: string;
  date: Date;
  tags: string[];
  headings?: { depth: number; slug: string; text: string }[];
  heroImage?: string;
}

const { title, description, date, tags, headings = [], heroImage } = Astro.props;
const postJsonLd = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: title,
  description,
  datePublished: date.toISOString(),
  dateModified: date.toISOString(),
  author: {
    "@type": "Person",
    name: site.author
  },
  publisher: {
    "@type": "Person",
    name: site.author
  },
  image: heroImage ? new URL(heroImage, site.url).toString() : new URL(site.ogImage, site.url).toString(),
  mainEntityOfPage: Astro.url.toString()
};
---

<BaseLayout title={title} description={description} image={heroImage} jsonLd={postJsonLd}>
  <section class="shell article-shell">
    <div class="article-header">
      <p class="eyebrow">Blog</p>
      <h1>{title}</h1>
      <p class="article-summary">{description}</p>
      <div class="article-meta">
        <time datetime={date.toISOString()}>
          {date.toLocaleDateString("en-US", {
            year: "numeric",
            month: "long",
            day: "numeric"
          })}
        </time>
        {tags.length > 0 && (
          <ul class="tag-list">
            {tags.map((tag) => <li>{tag}</li>)}
          </ul>
        )}
      </div>
    </div>

    <div class="article-layout">
      <article class="prose">
        <slot />
      </article>

      {headings.length > 1 && (
        <aside class="toc">
          <p class="toc-title">On this page</p>
          <ul>
            {headings
              .filter((heading) => heading.depth === 2)
              .map((heading) => (
                <li>
                  <a href={`#${heading.slug}`}>{heading.text}</a>
                </li>
              ))}
          </ul>
        </aside>
      )}
    </div>
  </section>
</BaseLayout>
